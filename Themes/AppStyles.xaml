<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        App-specific styles layered on top of the WPF-UI Fluent theme.
        All colors come from Fluent theme brushes (DynamicResource) so the UI
        follows the Windows light/dark setting and accent color.
    -->

    <!-- ===================== TYPOGRAPHY (Windows 11 type ramp) ===================== -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- ===================== SURFACES ===================== -->
    <!-- Fluent card: subtle layer fill + 1px stroke, 8px corners, no drop shadow -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Inset area inside a card (disk details, schedule form) -->
    <Style x:Key="InsetPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- Small status pill (health, task status) -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== DISK ROW (master combo box) ===================== -->
    <DataTemplate x:Key="DiskRowTemplate">
        <StackPanel Margin="0,2">
            <TextBlock Text="{Binding NameLine}" FontSize="14"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="{Binding MetaLine}" FontSize="12" Margin="0,1,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== PARTITION TILE ===================== -->
    <DataTemplate x:Key="PartitionTileTemplate">
        <Border Margin="0,2,6,4" Padding="10,8" CornerRadius="6" Width="118"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding DriveLetter}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding FileSystem}" FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <TextBlock Text="{Binding DisplayLabel}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,0,0,4"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding UsedSpaceFormatted, Mode=OneWay}"/>
                    <Run Text="of"/>
                    <Run Text="{Binding SizeFormatted, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
