<ui:FluentWindow x:Class="Replicore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Replicore.Views"
        Title="Replicore"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>     <!-- Body -->
        </Grid.RowDefinitions>

        <!-- ===================== TITLE BAR ===================== -->
        <ui:TitleBar Grid.Row="0" Title="Replicore">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="HardDrive20"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>  <!-- Navigation rail -->
                <ColumnDefinition Width="*"/>    <!-- Page content -->
            </Grid.ColumnDefinitions>

            <!-- ===================== NAVIGATION ===================== -->
            <DockPanel Grid.Column="0" Margin="8,4,8,12">
                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,8,0">
                    <TextBlock Text="Open source, not for sale" Style="{StaticResource CaptionText}"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                        <Run Text="Developed by"/>
                        <Run Text="Zin" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </TextBlock>
                </StackPanel>

                <ListBox x:Name="NavList" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="Clone">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy20" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Clone" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Schedule">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CalendarClock20" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Schedule" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="History">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History20" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Backup history" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Activity">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Pulse20" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Activity" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- ===================== PAGES ===================== -->
            <Grid Grid.Column="1" Margin="16,0,24,0">

                <!-- ============ CLONE PAGE ============ -->
                <Grid x:Name="ClonePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header -->
                        <RowDefinition Height="Auto"/>  <!-- Mirror warning -->
                        <RowDefinition Height="*"/>     <!-- Source + targets -->
                        <RowDefinition Height="Auto"/>  <!-- Command bar -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,4,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Clone" Style="{StaticResource PageTitleText}"/>
                            <TextBlock Text="Copy one source disk to several target disks at the same time."
                                       Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Border Style="{StaticResource SegmentedContainer}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DirectMirrorRadio" Style="{StaticResource SegmentedItem}" GroupName="CloneMode"
                                                 IsChecked="True" Checked="ModeRadio_Checked"
                                                 ToolTip="Copy the source sector by sector. Erases everything on each target.">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Copy20" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="Disk clone"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ImageBackupRadio" Style="{StaticResource SegmentedItem}" GroupName="CloneMode"
                                                 Checked="ModeRadio_Checked"
                                                 ToolTip="Create a Windows system image on each target. Existing files are kept.">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentCopy20" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="Image backup"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <ui:Button x:Name="RefreshButton" Content="Rescan" Margin="8,0,0,0" Height="36"
                                       Icon="{ui:SymbolIcon ArrowSync20}" Click="RefreshButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Clone warning (clone is the default mode, so this is visible on launch) -->
                    <ui:InfoBar x:Name="DirectCloneWarningBanner" Grid.Row="1" Margin="0,0,0,16"
                                Severity="Warning" IsClosable="False" IsOpen="True"
                                Title="Disk clone erases every selected target"
                                Message="All partitions, file systems and files on the target disks are permanently overwritten. Each target becomes an exact, bootable copy of the source."/>

                    <!-- Source + targets -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SOURCE -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="20">
                                    <Grid Margin="0,0,0,16">
                                        <TextBlock Text="SOURCE" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Border x:Name="MasterHealthPill" Style="{StaticResource Pill}" Margin="0"
                                                HorizontalAlignment="Right" Visibility="Collapsed">
                                            <TextBlock x:Name="MasterHealthText" Text="Healthy" Style="{StaticResource PillText}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Selected source summary -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource IconTile}" Width="52" Height="52" Margin="0,0,14,0"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="0">
                                            <ui:SymbolIcon Symbol="HardDrive20" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="MasterModelText" Text="No disk selected" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock x:Name="MasterDetailText" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Source disk" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="MasterComboBox" HorizontalAlignment="Stretch"
                                              ItemTemplate="{StaticResource DiskRowTemplate}"/>

                                    <TextBlock Text="Partitions" Style="{StaticResource SectionTitleText}" Margin="0,20,0,12"/>
                                    <views:PartitionMapBar x:Name="MasterLayoutBar" Height="28"/>

                                    <TextBlock Text="Volumes" Style="{StaticResource SectionTitleText}" Margin="0,20,0,12"/>
                                    <ItemsControl x:Name="MasterPartitionsControl" ItemTemplate="{StaticResource PartitionRowTemplate}"/>
                                    <TextBlock x:Name="MasterNoPartitionsText" Text="No mounted volumes" Style="{StaticResource CaptionText}"
                                               FontStyle="Italic" Visibility="Collapsed"/>

                                    <TextBlock Text="Health" Style="{StaticResource SectionTitleText}" Margin="0,20,0,12"/>
                                    <ui:InfoBar x:Name="MasterHealthBar" IsClosable="False" IsOpen="False" Margin="0,0,0,12"/>
                                    <ItemsControl x:Name="MasterHealthDetailsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text="{Binding Value}" FontSize="12" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="MasterNoHealthText" Text="This drive doesn't report health data."
                                               Style="{StaticResource CaptionText}" FontStyle="Italic" Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- TARGETS -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TARGETS" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TargetCountText" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button x:Name="AddImageButton" Content="Image file" Appearance="Transparent" Margin="0,0,4,0"
                                               Icon="{ui:SymbolIcon Add20}" Click="AddImageButton_Click"
                                               ToolTip="Clone the source into a .vhdx image file instead of a disk"/>
                                    <ui:Button x:Name="SelectAllButton" Content="Select all" Appearance="Transparent"
                                               Icon="{ui:SymbolIcon SelectAllOn20}" Click="SelectAllButton_Click"/>
                                    <ui:Button x:Name="ClearSelectionButton" Content="Clear" Appearance="Transparent" Margin="4,0,0,0"
                                               Icon="{ui:SymbolIcon SelectAllOff20}" Click="ClearSelectionButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="TargetsItemsControl" ItemTemplate="{StaticResource TargetDiskCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Empty state -->
                            <Border x:Name="TargetsEmptyState" Grid.Row="1" Style="{StaticResource Card}" Padding="32"
                                    VerticalAlignment="Top" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Style="{StaticResource IconTile}" Width="56" Height="56" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="UsbStick24" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="No target disks found" Style="{StaticResource SectionTitleText}"
                                               HorizontalAlignment="Center" Margin="0,14,0,4"/>
                                    <TextBlock Text="Connect one or more drives, then select Rescan." Style="{StaticResource CaptionText}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Command bar -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,16" Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="JobSummaryTitle" Text="Select target disks" Style="{StaticResource LabelText}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="JobSummaryDetail" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0">
                                <StackPanel x:Name="CloneOptionsPanel" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <CheckBox x:Name="SmartCopyCheckBox" Content="Copy used space only" IsChecked="True" MinHeight="0"
                                              ToolTip="Skip free space inside NTFS volumes. Much faster on a disk that isn't full, and keeps image files small. Turn off for an exact copy of every sector."/>
                                    <CheckBox x:Name="VerifyCheckBox" Content="Verify after cloning" IsChecked="True" MinHeight="0" Margin="0,4,0,0"
                                              ToolTip="Re-read every target and compare it with the source. Takes about as long as the copy itself."/>
                                </StackPanel>
                                <TextBlock Text="When finished" Style="{StaticResource CaptionText}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="PostBackupActionComboBox" SelectedIndex="0" Width="170">
                                    <ComboBoxItem Content="Do nothing"/>
                                    <ComboBoxItem Content="Shut down PC"/>
                                    <ComboBoxItem Content="Put PC to sleep"/>
                                </ComboBox>
                            </StackPanel>

                            <Grid Grid.Column="2" Width="170">
                                <ui:Button x:Name="StartBackupButton" Content="Start clone" Appearance="Primary"
                                           Icon="{ui:SymbolIcon Play20}" HorizontalAlignment="Stretch" Height="36"
                                           Click="StartBackupButton_Click"/>
                                <ui:Button x:Name="CancelBackupButton" Content="Cancel" Appearance="Danger"
                                           Icon="{ui:SymbolIcon Dismiss20}" HorizontalAlignment="Stretch" Height="36"
                                           Visibility="Collapsed" Click="CancelBackupButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ SCHEDULE PAGE ============ -->
                <ScrollViewer x:Name="SchedulePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,24" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Schedule" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Text="Run image backups automatically every week with Windows Task Scheduler."
                                   Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,20"/>

                        <!-- Settings-style rows -->
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Grid Margin="20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="CalendarLtr20" FontSize="20" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Day" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="The backup runs once a week on this day." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="ScheduleDayComboBox" SelectedIndex="0" Width="180">
                                        <ComboBoxItem Content="Sunday"/>
                                        <ComboBoxItem Content="Monday"/>
                                        <ComboBoxItem Content="Tuesday"/>
                                        <ComboBoxItem Content="Wednesday"/>
                                        <ComboBoxItem Content="Thursday"/>
                                        <ComboBoxItem Content="Friday"/>
                                        <ComboBoxItem Content="Saturday"/>
                                    </ComboBox>
                                </Grid>
                                <Separator Margin="0"/>
                                <Grid Margin="20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="CalendarClock20" FontSize="20" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Start time" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="24-hour format, for example 02:00 or 23:30." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <ui:TextBox Grid.Column="2" x:Name="ScheduleTimeTextBox" Text="02:00" PlaceholderText="HH:mm"
                                                ClearButtonEnabled="False" Width="180"/>
                                </Grid>
                                <Separator Margin="0"/>
                                <Grid Margin="20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Layer20" FontSize="20" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Backup type" Style="{StaticResource BodyText}"/>
                                        <TextBlock x:Name="ScheduleTypeCaption" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Text="Every volume on the source disk plus the boot files, so Windows can be restored from it."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="ScheduleTypeComboBox" SelectedIndex="0" Width="180"
                                              SelectionChanged="ScheduleTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Full system image"/>
                                        <ComboBoxItem Content="Selected volumes"/>
                                        <ComboBoxItem Content="Selected folders"/>
                                    </ComboBox>
                                    <!-- Selected folders: the folders to copy -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ScheduleFoldersPanel"
                                                Visibility="Collapsed" Margin="0,12,0,0">
                                        <ListBox x:Name="ScheduleFoldersListBox" MinHeight="40" MaxHeight="180" SelectionMode="Extended"
                                                 SelectionChanged="ScheduleFoldersListBox_SelectionChanged"/>
                                        <TextBlock x:Name="ScheduleNoFoldersText" Text="No folders added yet."
                                                   Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <ui:Button x:Name="ScheduleAddFolderButton" Content="Add folders"
                                                       Icon="{ui:SymbolIcon FolderAdd20}" Click="ScheduleAddFolderButton_Click"/>
                                            <ui:Button x:Name="ScheduleRemoveFolderButton" Content="Remove" Margin="8,0,0,0" IsEnabled="False"
                                                       Icon="{ui:SymbolIcon Dismiss20}" Click="ScheduleRemoveFolderButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="ScheduleSourceSection">
                                    <Separator Margin="0"/>
                                    <Grid Margin="20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="HardDrive20" FontSize="20" Margin="0,0,16,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Source disk" Style="{StaticResource BodyText}"/>
                                            <TextBlock Text="The disk whose volumes are backed up." Style="{StaticResource CaptionText}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="ScheduleSourceComboBox" Width="300"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="ScheduleSourceComboBox_SelectionChanged"/>
                                        <!-- Selected volumes: pick the volumes to include -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ScheduleCustomPanel"
                                                    Visibility="Collapsed" Margin="0,12,0,0">
                                            <WrapPanel x:Name="ScheduleVolumesPanel"/>
                                            <TextBlock x:Name="ScheduleNoVolumesText" Text="This disk has no volumes with a drive letter."
                                                       Style="{StaticResource CaptionText}" Visibility="Collapsed"/>
                                            <CheckBox x:Name="ScheduleBootableCheckBox" Margin="0,8,0,0"
                                                      Content="Also include the boot files, so Windows can be restored from this backup"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Separator Margin="0"/>
                                <Grid Margin="20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="FolderArrowRight20" FontSize="20" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Backup destination" Style="{StaticResource BodyText}"/>
                                        <TextBlock x:Name="ScheduleDestinationCaption" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Text="A drive such as E: or a network share such as \\server\backups. Windows saves the image in a WindowsImageBackup folder at the root of a drive."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBox x:Name="ScheduleDestinationTextBox" PlaceholderText="E: or \\server\share"
                                                    ClearButtonEnabled="False" Width="200"/>
                                        <ui:Button x:Name="ScheduleBrowseButton" Content="Browse" Margin="8,0,0,0"
                                                   Icon="{ui:SymbolIcon FolderOpen20}" Click="ScheduleBrowseButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Separator Margin="0"/>
                                <Grid Margin="20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Save20" FontSize="20" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Add schedule" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="Adds a weekly task to Task Scheduler. Each schedule runs on its own."
                                                   Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" x:Name="SaveScheduleButton" Content="Add schedule" Appearance="Primary"
                                               Icon="{ui:SymbolIcon Add20}" Width="180" Click="SaveScheduleButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,16,0,0"
                                    Title="Keep the drives connected"
                                    Message="Backups run under the SYSTEM account, wake the PC from sleep, and run as soon as possible if the PC was off at the scheduled time. The source and destination must be connected, and a network share must allow write access for this computer's account."/>

                        <!-- Saved schedules -->
                        <Grid Margin="0,24,0,8">
                            <TextBlock Text="Scheduled backups" Style="{StaticResource BodyText}" FontWeight="SemiBold" FontSize="16"/>
                            <ui:Button x:Name="RefreshSchedulesButton" Content="Refresh" HorizontalAlignment="Right"
                                       Icon="{ui:SymbolIcon ArrowSync20}" Click="RefreshSchedulesButton_Click"/>
                        </Grid>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <TextBlock x:Name="SchedulesEmptyText" Margin="20,16" Style="{StaticResource CaptionText}"
                                           Text="No scheduled backups yet. Add one above."/>
                                <ItemsControl x:Name="SchedulesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <Grid Margin="20,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="0" Symbol="CalendarSync20" FontSize="20" Margin="0,0,16,0"
                                                                   VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding When}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Foreground="{Binding StatusBrush}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Content="Run now" Icon="{ui:SymbolIcon Play20}" Tag="{Binding Schedule}"
                                                                   Click="RunScheduleNowButton_Click"/>
                                                        <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete20}" Margin="8,0,0,0"
                                                                   Tag="{Binding Schedule}" Click="DeleteOneScheduleButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Delete20" FontSize="20" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Remove all scheduled backups" Style="{StaticResource BodyText}"/>
                                    <TextBlock Text="Deletes every Replicore task from Task Scheduler. Backup history is kept." Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                                <ui:Button Grid.Column="2" x:Name="DeleteScheduleButton" Content="Remove all" Width="180"
                                           Click="DeleteScheduleButton_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ HISTORY PAGE ============ -->
                <Grid x:Name="HistoryPage" Visibility="Collapsed" Margin="0,4,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Backup history" Style="{StaticResource PageTitleText}"/>
                            <TextBlock Text="Every backup and clone Replicore ran, including scheduled backups that ran while the app was closed."
                                       Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ui:Button x:Name="RefreshHistoryButton" Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Icon="{ui:SymbolIcon ArrowSync20}" Height="36" Click="RefreshHistoryButton_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                        <Grid>
                            <ui:ListView x:Name="RunsListView">
                                <ui:ListView.View>
                                    <ui:GridView>
                                        <GridViewColumn Header="Started" Width="140" DisplayMemberBinding="{Binding StartedText}"/>
                                        <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding StatusText}"/>
                                        <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Kind}"/>
                                        <GridViewColumn Header="Trigger" Width="100" DisplayMemberBinding="{Binding TriggerLabel}"/>
                                        <GridViewColumn Header="Source" Width="200" DisplayMemberBinding="{Binding Source}"/>
                                        <GridViewColumn Header="Destination" Width="160" DisplayMemberBinding="{Binding Destination}"/>
                                        <GridViewColumn Header="Duration" Width="80" DisplayMemberBinding="{Binding DurationText}"/>
                                        <GridViewColumn Header="Details" Width="320" DisplayMemberBinding="{Binding Details}"/>
                                        <GridViewColumn Header="Log" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:Button Content="Open" Tag="{Binding LogPath}" Click="OpenRunLogButton_Click"
                                                               Visibility="{Binding HasLog, Converter={StaticResource BoolToVisibility}}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </ui:GridView>
                                </ui:ListView.View>
                            </ui:ListView>
                            <TextBlock x:Name="RunsEmptyText" Text="No backups recorded yet." Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Windows image versions that wbadmin finds on a drive, including ones made outside Replicore -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Search20" FontSize="20" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Image versions on a drive" Style="{StaticResource BodyText}"/>
                                    <TextBlock Text="Lists the Windows image backups stored on a drive or network share, ready to restore."
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:TextBox x:Name="HistoryScanPathTextBox" PlaceholderText="E: or \\server\share"
                                                ClearButtonEnabled="False" Width="200"/>
                                    <ui:Button x:Name="LoadHistoryButton" Content="Scan" Margin="8,0,0,0"
                                               Icon="{ui:SymbolIcon Search20}" Click="LoadHistoryButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <ui:ListView x:Name="HistoryListView" MaxHeight="220" Margin="0,12,0,0" Visibility="Collapsed">
                                <ui:ListView.View>
                                    <ui:GridView>
                                        <GridViewColumn Header="Date and time" Width="180" DisplayMemberBinding="{Binding Timestamp}"/>
                                        <GridViewColumn Header="Version ID" Width="180" DisplayMemberBinding="{Binding VersionId}"/>
                                        <GridViewColumn Header="Source" Width="180" DisplayMemberBinding="{Binding Location}"/>
                                        <GridViewColumn Header="Recoverable items" Width="280" DisplayMemberBinding="{Binding RecoverableItems}"/>
                                    </ui:GridView>
                                </ui:ListView.View>
                            </ui:ListView>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ ACTIVITY PAGE ============ -->
                <Grid x:Name="ActivityPage" Visibility="Collapsed" Margin="0,4,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Activity" Style="{StaticResource PageTitleText}"/>
                            <TextBlock Text="Everything Replicore did in this session." Style="{StaticResource CaptionText}"
                                       FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LogCountText" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <ScrollViewer x:Name="LogScrollViewer" Padding="12" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LogPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============ SCANNING OVERLAY ============ -->
                <Grid x:Name="ScanOverlay" Background="Transparent">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                        <StackPanel x:Name="ScanningPanel" HorizontalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"/>
                            <TextBlock Text="Scanning disks..." Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="ScanErrorPanel" Visibility="Collapsed">
                            <ui:InfoBar x:Name="ScanErrorBar" Severity="Error" IsClosable="False" IsOpen="True" Title="Couldn't scan disks"/>
                            <ui:Button Content="Try again" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync20}"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" Click="RetryScanButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Hosts in-window Fluent dialogs (ContentDialog) above everything else -->
        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</ui:FluentWindow>
