<ui:FluentWindow x:Class="Replicore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Replicore"
        Height="780" Width="1040"
        MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Window.Resources>
        <Storyboard x:Key="BlinkCursor">
            <DoubleAnimation Storyboard.TargetName="BlinkingCursor"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.5"
                             AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        <Storyboard x:Key="TransitionToDashboard">
            <DoubleAnimation Storyboard.TargetName="TerminalStartGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="DashboardGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.5"/>
        </Storyboard>

        <DataTemplate x:Key="DiskCheckboxRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                          MinWidth="0" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NameLine}" FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding MetaLine}" FontSize="12" Margin="0,1,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title Bar -->
            <RowDefinition Height="*"/>     <!-- Client Area -->
        </Grid.RowDefinitions>

        <!-- ===================== TITLE BAR ===================== -->
        <ui:TitleBar Grid.Row="0" Title="Replicore">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="HardDrive20"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ===================== DASHBOARD ===================== -->
        <Grid x:Name="DashboardGrid" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Page header -->
                <RowDefinition Height="*"/>      <!-- Main split -->
            </Grid.RowDefinitions>

            <!-- Page header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Disk cloning and backup" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Snapshot your system disk with Volume Shadow Copy (VSS), or clone a disk sector by sector."
                           Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>  <!-- Left: disks & settings -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>    <!-- Right: progress & tabs -->
                </Grid.ColumnDefinitions>

                <!-- ===================== LEFT COLUMN ===================== -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">

                        <!-- SOURCE -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="HardDrive20" FontSize="18" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Source disk" Style="{StaticResource SectionTitleText}"/>
                                    <Border Grid.Column="2" x:Name="MasterHealthPill" Style="{StaticResource Pill}" Visibility="Collapsed">
                                        <TextBlock x:Name="MasterHealthText" Text="Healthy" FontSize="12"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </Border>
                                </Grid>

                                <ComboBox x:Name="MasterComboBox" HorizontalAlignment="Stretch"
                                          ItemTemplate="{StaticResource DiskRowTemplate}"/>

                                <Border x:Name="MasterDetailBorder" Style="{StaticResource InsetPanel}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="MasterDetailText" Style="{StaticResource CaptionText}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Partitions" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
                                        <ItemsControl x:Name="MasterPartitionsControl" ItemTemplate="{StaticResource PartitionTileTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock x:Name="MasterNoPartitionsText" Text="No partitions detected" Style="{StaticResource CaptionText}"
                                                   FontStyle="Italic" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Connector arrow -->
                        <ui:SymbolIcon Symbol="ArrowDown20" FontSize="16" HorizontalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                        <!-- TARGET -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Storage20" FontSize="18" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Target disks" Style="{StaticResource SectionTitleText}"/>
                                    <Border Grid.Column="2" x:Name="TargetHealthPill" Style="{StaticResource Pill}" Visibility="Collapsed">
                                        <TextBlock x:Name="TargetHealthText" Text="Healthy" FontSize="12"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <ListBox x:Name="TargetsListBox" Height="160"
                                             ItemTemplate="{StaticResource DiskCheckboxRowTemplate}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                                    <!-- Empty state shown when no target disks are available -->
                                    <StackPanel x:Name="TargetsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsHitTestVisible="False" Visibility="Collapsed">
                                        <TextBlock Text="No other disks detected" Style="{StaticResource BodyText}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Connect a drive, then select Scan disks" Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="TargetDetailBorder" Style="{StaticResource InsetPanel}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TargetDetailText" Style="{StaticResource CaptionText}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Partitions" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
                                        <ItemsControl x:Name="TargetPartitionsControl" ItemTemplate="{StaticResource PartitionTileTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock x:Name="TargetNoPartitionsText" Text="No partitions detected" Style="{StaticResource CaptionText}"
                                                   FontStyle="Italic" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- OPTIONS & ACTIONS -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Mode" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                <RadioButton x:Name="ImageBackupRadio" Content="Image backup (safe)" IsChecked="True" GroupName="CloneMode" Checked="ModeRadio_Checked"/>
                                <RadioButton x:Name="DirectMirrorRadio" Content="Direct disk mirror (erases target)" GroupName="CloneMode" Checked="ModeRadio_Checked"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="When finished" VerticalAlignment="Center" Style="{StaticResource BodyText}"/>
                                    <ComboBox Grid.Column="2" x:Name="PostBackupActionComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Do nothing"/>
                                        <ComboBoxItem Content="Shut down PC"/>
                                        <ComboBoxItem Content="Put PC to sleep"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:Button x:Name="RefreshButton" Grid.Column="0" Content="Scan disks"
                                               Icon="{ui:SymbolIcon ArrowSync20}" HorizontalAlignment="Stretch"
                                               Click="RefreshButton_Click"/>

                                    <Grid Grid.Column="2">
                                        <ui:Button x:Name="StartBackupButton" Content="Start backup" Appearance="Primary"
                                                   Icon="{ui:SymbolIcon Play20}" HorizontalAlignment="Stretch"
                                                   Click="StartBackupButton_Click"/>
                                        <ui:Button x:Name="CancelBackupButton" Content="Cancel" Appearance="Danger"
                                                   Icon="{ui:SymbolIcon Dismiss20}" HorizontalAlignment="Stretch"
                                                   Visibility="Collapsed" Click="CancelBackupButton_Click"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Direct mirror warning -->
                        <ui:InfoBar x:Name="DirectCloneWarningBanner" Margin="0,12,0,0"
                                    Severity="Error" IsClosable="False" IsOpen="False"
                                    Title="This erases the target disk"
                                    Message="Direct disk mirroring permanently overwrites every partition, file system and file on the target. Check that you selected the right disk."/>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== RIGHT COLUMN ===================== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Progress -->
                        <RowDefinition Height="*"/>     <!-- Tabs -->
                    </Grid.RowDefinitions>

                    <!-- Progress card -->
                    <Border Style="{StaticResource Card}" x:Name="ProgressCard" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ProgressTitleText" Text="Progress" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ActiveProgressesControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>    <!-- Disk name -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Speed -->
                                                        <ColumnDefinition Width="Auto"/> <!-- ETA -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Percent -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Status -->
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TargetDiskName}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Speed}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Eta}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Percent, StringFormat={}{0}%}" FontSize="12" FontWeight="SemiBold"
                                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <Border Grid.Column="4" Style="{StaticResource Pill}" Margin="12,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Tabs: activity log, backup history, schedule -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                        <TabControl x:Name="MainTabControl">

                            <!-- TAB 1: ACTIVITY LOG -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentText20" Margin="0,0,6,0"/>
                                        <TextBlock Text="Activity log"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Operation output" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="LogCountText" Text="" Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Grid.Row="1" Style="{StaticResource InsetPanel}" Padding="0">
                                        <ScrollViewer x:Name="LogScrollViewer" Padding="8" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="LogPanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- TAB 2: BACKUP HISTORY -->
                            <TabItem x:Name="HistoryTab">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="History20" Margin="0,0,6,0"/>
                                        <TextBlock Text="Backup history"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:Button x:Name="LoadHistoryButton" Grid.Column="0" Content="Scan target for backups"
                                                   Icon="{ui:SymbolIcon Search20}" Click="LoadHistoryButton_Click"/>
                                        <TextBlock Grid.Column="1" Text="Lists Windows image backups stored on the selected target volume."
                                                   VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource CaptionText}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <ui:ListView Grid.Row="1" x:Name="HistoryListView">
                                        <ui:ListView.View>
                                            <ui:GridView>
                                                <GridViewColumn Header="Date and time" Width="150" DisplayMemberBinding="{Binding Timestamp}"/>
                                                <GridViewColumn Header="Version ID" Width="150" DisplayMemberBinding="{Binding VersionId}"/>
                                                <GridViewColumn Header="Source" Width="140" DisplayMemberBinding="{Binding Location}"/>
                                                <GridViewColumn Header="Recoverable items" Width="220" DisplayMemberBinding="{Binding RecoverableItems}"/>
                                            </ui:GridView>
                                        </ui:ListView.View>
                                    </ui:ListView>
                                </Grid>
                            </TabItem>

                            <!-- TAB 3: SCHEDULE -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="CalendarClock20" Margin="0,0,6,0"/>
                                        <TextBlock Text="Schedule"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Run system image backups automatically with Windows Task Scheduler."
                                                   Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <Border Style="{StaticResource InsetPanel}" Padding="16" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Day" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyText}"/>
                                                <ComboBox Grid.Column="1" x:Name="ScheduleDayComboBox" SelectedIndex="0">
                                                    <ComboBoxItem Content="Sunday"/>
                                                    <ComboBoxItem Content="Monday"/>
                                                    <ComboBoxItem Content="Tuesday"/>
                                                    <ComboBoxItem Content="Wednesday"/>
                                                    <ComboBoxItem Content="Thursday"/>
                                                    <ComboBoxItem Content="Friday"/>
                                                    <ComboBoxItem Content="Saturday"/>
                                                </ComboBox>

                                                <TextBlock Grid.Column="3" Text="Time" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyText}"/>
                                                <ui:TextBox Grid.Column="4" x:Name="ScheduleTimeTextBox" Text="02:00" PlaceholderText="HH:mm"
                                                            ClearButtonEnabled="False" VerticalAlignment="Center"/>

                                                <ui:Button Grid.Column="6" x:Name="SaveScheduleButton" Content="Register task" Appearance="Primary"
                                                           Icon="{ui:SymbolIcon Save20}" Click="SaveScheduleButton_Click"/>
                                            </Grid>
                                        </Border>

                                        <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="How scheduled backups work"
                                                    Message="Replicore registers a weekly task that runs under the SYSTEM account and backs up the selected source to the selected target volumes. Keep both drives connected at the scheduled time."/>

                                        <ui:Button x:Name="DeleteScheduleButton" Content="Remove scheduled tasks" Margin="0,12,0,0"
                                                   Icon="{ui:SymbolIcon Delete20}" HorizontalAlignment="Left" Click="DeleteScheduleButton_Click"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== WELCOME & SCAN SCREEN ===================== -->
        <Grid x:Name="TerminalStartGrid" Grid.Row="1" Margin="24,4,24,24" Visibility="Visible" Opacity="1">
            <Border x:Name="StartButtonCenteringGrid" Style="{StaticResource Card}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="40,32" Width="440">
                <StackPanel>
                    <ui:SymbolIcon Symbol="HardDrive24" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Replicore" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Scan your physical disks to get started." Style="{StaticResource CaptionText}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                    <ui:Button x:Name="StartScanButton" Content="Scan disks" Appearance="Primary"
                               Icon="{ui:SymbolIcon Search20}" HorizontalAlignment="Stretch" Height="40"
                               Click="StartScanButton_Click"/>

                    <Separator Margin="0,24,0,16"/>

                    <TextBlock Text="This tool is open source and not intended for sale"
                               Style="{StaticResource CaptionText}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource CaptionText}">
                        <Run Text="Developed by"/>
                        <Run Text="Zin" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Scan console (hidden until the scan starts) -->
            <Border x:Name="ConsoleBorder" Style="{StaticResource Card}" Padding="24" Visibility="Collapsed" Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ConsoleScale" ScaleX="0.1" ScaleY="0.05"/>
                </Border.RenderTransform>
                <ScrollViewer x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="TerminalWelcomeText" FontFamily="Cascadia Mono, Consolas" FontSize="11" LineHeight="14"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" xml:space="preserve">
██████╗ ███████╗██████╗ ██╗     ██╗  ██████╗ ██████╗ ██████╗ ███████╗
██╔══██╗██╔════╝██╔══██╗██║     ██║ ██╔════╝██╔═══██╗██╔══██╗██╔════╝
██████╔╝█████╗  ██████╔╝██║     ██║ ██║     ██║   ██║██████╔╝█████╗
██╔══██╗██╔══╝  ██╔═══╝ ██║     ██║ ██║     ██║   ██║██╔══██╗██╔══╝
██║  ██║███████╗██║     ███████╗██║ ╚██████╗╚██████╔╝██║  ██║███████╗
╚═╝  ╚═╝╚══════╝╚═╝     ╚══════╝╚═╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝
                        </TextBlock>

                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="13" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
Replicore System Replication Engine [CLI Mode v1.2.4]
(c) 2026 Replicore Labs. All rights reserved.
----------------------------------------------------------------------
                        </TextBlock>

                        <TextBlock x:Name="TerminalOutputText" FontFamily="Cascadia Mono, Consolas" FontSize="13" LineHeight="20"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0">
                            <Run x:Name="TerminalTextRun" Text=""/>
                            <InlineUIContainer x:Name="CursorContainer">
                                <TextBlock x:Name="BlinkingCursor" Text="█" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </InlineUIContainer>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Hosts in-window Fluent dialogs (ContentDialog) above everything else -->
        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</ui:FluentWindow>
