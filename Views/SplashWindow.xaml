<ui:FluentWindow x:Class="Replicore.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Replicore"
        Width="460" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <!-- Startup screen shown while the first disk scan runs -->
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="16" HorizontalAlignment="Center"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <ui:SymbolIcon Symbol="HardDrive20" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <TextBlock Text="Replicore" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Disk cloning for Windows" Style="{StaticResource CaptionText}" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"/>
            <TextBlock Text="Scanning disks..." Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
